# Copy to `.env` next to docker-compose.prod.yml, then edit.
# `.env` is gitignored — never commit real tokens.
#
# Only GPTOSS_API_URL has no working default. Everything else below is already the
# compose default and is repeated here so you can see and change it.

# ---- gpt-oss: the main reasoning model (REQUIRED) ----------------------------------
# A full OpenAI-compatible chat-completions URL. pipeline-api calls it directly.
#
# Option A — let this stack serve it. Start with `--profile local-gptoss` (needs a
# spare GPU) and use the in-network address:
#   GPTOSS_API_URL=http://vllm-gptoss:8001/v1/chat/completions
#   GPTOSS_MODEL=openai/gpt-oss-120b
#
# Option B — point at an OpenAI-compatible server you already run. Check
# `curl <base>/v1/models` and set GPTOSS_MODEL to an id it reports; servers differ
# (a self-hosted vLLM reports `openai/gpt-oss-120b`, others use a short alias).
GPTOSS_API_URL=http://your-gpt-oss-host:8001/v1/chat/completions
GPTOSS_MODEL=openai/gpt-oss-120b

# ---- vllm-openbio: the reviewer model (runs locally on a GPU) -----------------------
# vLLM image tag. Pin a known-good version in production; OpenBioLLM fp8 + sleep mode
# needs a reasonably recent vLLM that supports --enable-sleep-mode.
VLLM_TAG=latest

# HuggingFace token — required if the model is gated (OpenBioLLM's Llama base may be).
HF_TOKEN=

# Persistent model cache. First run downloads OpenBioLLM-70B (~130GB) here once.
HF_CACHE=/data/ipsa/llm/hf-cache

# GPU index(es) for OpenBioLLM. Pick a free index from `nvidia-smi -L`.
OPENBIO_GPUS=0

# Tensor parallelism (number of GPUs for the model). For OpenBioLLM across 2 GPUs:
#   OPENBIO_GPUS=2,3   OPENBIO_TP=2
OPENBIO_TP=1

# Fraction of the GPU the model may reserve (weights + KV cache), 0-1.
# OpenBioLLM-70B at fp8 needs roughly 66GB for weights alone, plus room for a KV cache,
# so the floor depends on your card: on an 80GB GPU stay at 0.90 or above; on a 140GB
# GPU you can go as low as ~0.55 and leave the rest free for other work. Setting this
# below the weight footprint makes vLLM fail to allocate a KV cache at startup.
# While the model sleeps (level 1) this GPU memory is released anyway.
OPENBIO_MEM_UTIL=0.90

# ---- llm-router: sleep-aware router in front of the reviewer model ------------------
# Host port the router listens on. pipeline-api reaches it in-network as llm-router:9000.
ROUTER_PORT=9000
ROUTER_TAG=latest
# vLLM sleep level: 1 = offload weights to CPU RAM (fast wake; recommended if you have
#                       the host RAM to spare).
#                   2 = discard weights, reload from disk on wake (slower).
SLEEP_LEVEL=1
# Sleep the model after this many idle seconds (frees its GPU). The next request wakes
# it automatically, in a few seconds.
IDLE_TIMEOUT_SECONDS=600

# ---- pipeline-api: the 5-step interpretation API ------------------------------------
# Host port the FastAPI service publishes.
PIPELINE_PORT=6000

# Image tag for the built pipeline-api image. Pin it to a build number in CI so deploys
# are versioned and can be rolled back.
PIPELINE_TAG=latest

# ---- Optional: local gpt-oss (only used with `--profile local-gptoss`) --------------
# These four have NO effect unless that profile is enabled.
#
# GPU index(es) for gpt-oss. MUST NOT overlap OPENBIO_GPUS.
GPTOSS_GPUS=1
# Tensor parallelism for gpt-oss.
GPTOSS_TP=1
# Fraction of its GPU gpt-oss may reserve (weights + KV cache), 0-1. Same trade-off as
# OPENBIO_MEM_UTIL: too low and vLLM cannot allocate a KV cache at startup.
GPTOSS_MEM_UTIL=0.90
# Host port the local gpt-oss server publishes, so you can `curl :8001/v1/models`.
GPTOSS_PORT=8001
